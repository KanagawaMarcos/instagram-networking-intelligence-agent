# Aplicação
NODE_ENV=development
DEMO_MODE=true
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
SESSION_SECRET=substitua-por-um-segredo-longo

# Banco/filas (opcionais no modo demonstracao)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagram_networking?schema=public
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=3
ANALYSIS_BATCH_SIZE=25

# Claude: mantidos exclusivamente no servidor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Meta Graph API: conta profissional e permissões aprovadas são necessárias.
# O onboarding e Configurações também permitem salvar token/ID pela UI em cofre criptografado local.
# Em produção, defina obrigatoriamente uma chave longa e aleatória abaixo.
INSTAGRAM_GRAPH_API_VERSION=v24.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=
# Opcional: caminho para o cofre local criptografado (padrão: .nexo/instagram-credentials.enc)
NEXO_INTEGRATION_SETTINGS_PATH=
